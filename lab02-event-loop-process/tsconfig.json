{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "verbatimModuleSyntax": true,
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "types": [
            "node"
        ],
        "skipLibCheck": true,
        "noEmitOnError": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}